{
  "name": "brain-bugs-site",
  "private": true,
  "version": "1.0.0",
  "description": "Jekyll site and Playwright smoke tests for Brain Bugs",
  "scripts": {
    "test:a11y": "playwright test tests/a11y --reporter=list",
    "test:a11y:baseline": "playwright test tests/a11y/site-baseline.spec.ts --reporter=list",
    "test:a11y:strict": "A11Y_FAIL_ON_VIOLATIONS=1 playwright test tests/a11y --reporter=list",
    "lint:md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.11.30",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^3.0.0",
    "markdownlint-cli2": "^0.24.1",
    "postcss-scss": "^4.0.9",
    "stylelint": "^16.10.0",
    "stylelint-scss": "^6.6.1"
  }
}
